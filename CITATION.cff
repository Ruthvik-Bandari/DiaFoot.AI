    given-names: Ruthvik Nath
    affiliation: "Northeastern University"
repository-code: "https://github.com/Ruthvik-Bandari/DiaFoot.AI"
license: MIT
keywords:
  - medical-imaging
  - semantic-segmentation
  - diabetic-foot-ulcer
  - data-leakage
  - reproducibility
